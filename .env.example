# OpenAI-compatible gateway (OpenRouter by default)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=

# OpenRouter optional headers
HTTP_REFERER=https://github.com/public/The-71st-Language-Bench
X_TITLE=The 71st Language Bench

# Models: judge MUST differ from the model under test
TARGET_MODEL=openai/gpt-4o-mini
TRANSLATE_MODEL=meta-llama/llama-3.1-70b-instruct
JUDGE_MODEL=openai/gpt-4o-mini

# Sampling: 0 means use the full filtered set
SAMPLE_SIZE_HARMFUL=150
SAMPLE_SIZE_BENIGN=150
INCLUDE_XSTEST_UNSAFE=true
SEED=42

# Generation
TEMPERATURE=0
MAX_TOKENS=1024
TRANSLATE_MAX_TOKENS=1024
JUDGE_MAX_TOKENS=256
# Parallel API calls for translate / run / judge
CONCURRENCY=5
MAX_RETRIES=5

# Run folders are data/runs/<YYYYMMDD-HHMMSS>_<model>/
# Reports are reports/<YYYYMMDD-HHMMSS>_<model>.md and .zh.md
# Omit RUN_ID to reuse the current run for the same TARGET_MODEL.
# Set NEW_RUN=true to start a new timestamped folder.
# RUN_ID=20260919-235045_deepseek-flash
NEW_RUN=false
